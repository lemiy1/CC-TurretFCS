-- targets.lua
-- Add or remove names only in the c.target.names table.

local scriptPath = shell.getRunningProgram()
local scriptDir = fs.getDir(scriptPath)
local CONFIG_FILE = fs.combine(scriptDir, "config")

local function readFile(path)
    if not fs.exists(path) then
        error("File not found: " .. path)
    end

    local file = fs.open(path, "r")
    if not file then
        error("Could not open: " .. path)
    end

    local text = file.readAll()
    file.close()
    return text
end

local function writeFile(path, text)
    local file = fs.open(path, "w")
    if not file then
        error("Could not write: " .. path)
    end

    file.write(text)
    file.close()
end

local function trim(text)
    return text:match("^%s*(.-)%s*$")
end

local function quoteLuaString(text)
    text = text:gsub("\\", "\\\\")
    text = text:gsub('"', '\\"')
    return '"' .. text .. '"'
end

local function findTargetNames(config)
    local targetStart, targetOpen = config:find("c%.target%s*=%s*{")
    if not targetStart then
        error("Could not find c.target table in config.lua.")
    end

    local namesStart, namesOpen = config:find("names%s*=%s*{", targetOpen + 1)
    if not namesStart then
        error("Could not find names table inside c.target.")
    end

    local targetEnd = config:find("}", targetOpen + 1, true)
    if not targetEnd or namesOpen > targetEnd then
        error("Could not safely locate c.target.names. Config was not changed.")
    end

    local namesClose = config:find("}", namesOpen + 1, true)
    if not namesClose or namesClose > targetEnd then
        error("Could not find the closing brace for c.target.names.")
    end

    return namesStart, namesOpen, namesClose, config:sub(namesOpen + 1, namesClose - 1)
end

local function parseNames(text)
    local names = {}
    local position = 1

    while true do
        local first, last, name = text:find('"([^"]*)"', position)
        if not first then break end

        names[#names + 1] = name
        position = last + 1
    end

    local residue = text:gsub('"[^"]*"', ""):gsub("[%s,]", "")
    if residue ~= "" then
        error("Could not safely parse c.target.names. Config was not changed.")
    end

    return names
end

local function showNames(names)
    print("")
    print("Current target names:")

    if #names == 0 then
        print("  (list is empty)")
        return
    end

    for i, name in ipairs(names) do
        print("  " .. i .. ". " .. name)
    end
end

local function saveNames(config, namesStart, namesOpen, namesClose, names)
    local items = {}

    for i, name in ipairs(names) do
        items[i] = " " .. quoteLuaString(name)
    end

    local updatedNames = "names = {" .. table.concat(items, ",") .. " }"
    local updated = config:sub(1, namesStart - 1)
        .. updatedNames
        .. config:sub(namesClose + 1)

    write("Save changes to " .. CONFIG_FILE .. "? [y/N]: ")
    local answer = read()

    if answer ~= "y" and answer ~= "Y" then
        print("Cancelled. Config was not changed.")
        return
    end

    writeFile(CONFIG_FILE .. ".bak", config)
    writeFile(CONFIG_FILE, updated)

    print("Saved. Backup: " .. CONFIG_FILE .. ".bak")
    print("Restart main to load the updated target list.")
end

local function run()
    local config = readFile(CONFIG_FILE)
    local namesStart, namesOpen, namesClose, namesText = findTargetNames(config)
    local names = parseNames(namesText)

    showNames(names)
    print("")
    print("[A] Add a target")
    print("[R] Remove a target")
    print("[Q] Quit without changes")
    write("> ")

    local choice = trim(read()):lower()

    if choice == "a" then
        write("Enter the target name to add: ")
        local newName = trim(read())

        if newName == "" then
            print("No name entered. Config was not changed.")
            return
        end

        for _, name in ipairs(names) do
            if name == newName then
                print("That name is already in the list. Config was not changed.")
                return
            end
        end

        names[#names + 1] = newName
        print("Added: " .. newName)
        saveNames(config, namesStart, namesOpen, namesClose, names)

    elseif choice == "r" then
        if #names == 0 then
            print("The target list is empty.")
            return
        end

        write("Enter the list number or exact name to remove: ")
        local input = trim(read())
        local index = tonumber(input)

        if index then
            index = math.floor(index)
            if index < 1 or index > #names then
                print("Invalid list number. Config was not changed.")
                return
            end
        else
            for i, name in ipairs(names) do
                if name == input then
                    index = i
                    break
                end
            end

            if not index then
                print("Name not found. Config was not changed.")
                return
            end
        end

        local removed = table.remove(names, index)
        print("Removed: " .. removed)
        saveNames(config, namesStart, namesOpen, namesClose, names)

    elseif choice == "q" or choice == "" then
        print("No changes made.")
    else
        print("Invalid choice. No changes made.")
    end
end

local ok, err = pcall(run)
if not ok then
    print("ERROR: " .. tostring(err))
end