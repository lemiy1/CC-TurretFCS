-- config.lua

-- IMPORTS
local u = require("math_utils_v6")
local vec3 = u.Vector3
local c = {}

c.solver = {}

-- cannon config in the SOLVER FRAME.
-- Solver frame = world axes (x east, y up, z south) translated so that the cannon pivot is the origin.
-- Do NOT put world coordinates here: use c.cannon.world_pos below.
c.solver.cannon = {
    pos        = vec3.new(0, 0, 0),
    barrel_len = 6.5       -- pivot -> muzzle distance in blocks (verify for YOUR cannon)
}

-- solver projectile config rotary
-- (values from the original author's setup: verify for your cannon/ammo on 1.21.1)
c.solver.projectile = {
    muzzle_speed         = 9,
    gravity              = 0.025,
    drag_multiplier      = 0.99,
    proximity_detonation = 0
}

-- solver projectile config medium
--c.solver.projectile = {
--    muzzle_speed         = 17,
--    gravity              = 0.04,
--    drag_multiplier      = 0.99,
--    proximity_detonation = 0
--}

-- predictor config
c.solver.predictor = {

    dt = 0.05,   -- seconds between predictor updates (one game tick)

    -- "cv"       --> Constant Velocity (recommended for players with integer coordinates)
    -- "dumb"     --> Constant Acceleration (CA), acceleration is noisy with coarse coordinates
    -- "aircraft" --> CTRA numerically integrated
    mode = "cv",

    -- true  --> use omega + quaternion from radar peripheral (not available with Player Detector)
    -- false --> derive turn rate from smoothed velocity x acceleration
    -- only used with mode "aircraft"
    use_radar_rotation = false,

    -- physical constraints
    max_speed = 1000.0,
    max_accel = 20.0,
    min_speed = 1.0,

    -- velocity + acceleration EMA smoothing (same alpha for both, keeps them consistent)
    accel_alpha = 0.3,
    max_sim_time = 10,

}

-- solver system constants
c.solver.sys = {
    dt                   = 0.05,
    converge_iterations  = 7,
    converge_sensitivity = 0.4,
    converge_max_step    = math.huge,
    converge_tolerance   = 0.1,   -- stop iterating early if miss_dist drops below this (blocks)
    converge_reset_miss  = 50,    -- invalidate warm-start aim vec if last miss_dist exceeded this
    max_sim_time         = 10,
    min_pitch            = 0      -- NOTE: 0 means the cannon never aims below the horizon
}

-- CANNON IN THE WORLD
-- Mapping from solver (world) angles to Block Reader angles:
--     cannon_angle = sign * world_angle + offset_deg
-- Defaults assume that CannonYaw uses the Minecraft convention (0 = +Z, 90 = -X) and
-- CannonPitch is positive upward. NOT verified on 1.21.1: use the calibration (key C).
c.cannon = {
    -- REQUIRED. World coordinates of the cannon pitch/yaw pivot.
    -- Example: world_pos = { x = 100.5, y = 64.0, z = -20.5 },
    world_pos        = { x = 177.5, y = -41.094, z = -79.5},

    -- Only players in this dimension are accepted. Set to nil to accept any (not recommended).
    dimension        = "minecraft:overworld",

    yaw_sign         = 1,
    yaw_offset_deg   = 0,
    pitch_sign       = 1,
    pitch_offset_deg = 0,
}

-- TARGET SELECTION AND TRACKING
c.target = {
    -- Players to track. With several names the nearest valid one is chosen.
    -- Can be overridden from the command line:  main nick1 nick2
    -- Future: put the list of hostile nicknames here.
    names = { "lemiy_" },
    -- Optional player detection area. Set to nil to disable.
    pos1 = { x = 110, y = -110, z = -170 },
    pos2 = { x = 280, y = 110, z = 10 },

    -- Added to the detector coordinates (blocks). Defaults are zero on purpose.
    -- If the diagnostics warn that coordinates are integers, the real position is probably
    -- inside the block, e.g. x = 0.5, z = 0.5. y from the detector is probably the feet:
    -- for a seated driver try y = 1.0.
    pos_offset = { x = 0.314, y = 0.5, z = -0.314 },

    poll_sleep         = 0,     -- extra sleep (s) between detector polls; 0 = as fast as the game allows
    stale_s            = 0.5,   -- data older than this is not used
    history_gap_s      = 1.0,   -- a pause longer than this wipes the history (target lost)
    velocity_window_s  = 0.6,   -- window for the velocity regression (seconds)
    min_samples        = 4,     -- minimum samples before a velocity is trusted
    min_span_s         = 0.25,  -- minimum time span of the samples
    max_speed          = 200,   -- blocks/s: faster than this = teleport / garbage
    teleport_slack     = 2.0,   -- extra blocks tolerated on top of max_speed * dt
    use_fitted_pos     = false, -- true: use regression-smoothed position (less jitter, more lag)

    min_range          = 3,     -- blocks; closer targets are ignored
    max_range          = 400,   -- blocks; farther targets are ignored
    switch_margin      = 10,    -- blocks: only switch to another target if it is this much closer
}

-- peripheral config
c.peripheral = {
    RSC_TYPE             = "Create_RotationSpeedController",
    BLOCK_READER_TYPES   = { "block_reader", "blockReader" },   -- first one that is found is used
    PLAYER_DETECTOR_TYPE = "player_detector",                   -- verified in this build, do not change

    PITCH_RSC_INDEX = 1,
    YAW_RSC_INDEX   = 2,

    -- optional: exact peripheral names (more reliable than the index). Both must be set.
    -- Example: PITCH_RSC_NAME = "Create_RotationSpeedController_1"
    PITCH_RSC_NAME  = nil,
    YAW_RSC_NAME    = nil,

    PITCH_RSC_SIGN  = -1,
    YAW_RSC_SIGN    = 1,
}

-- controller pipeline
c.controller = {
    DT                 = 0.05,
    D_READ             = 1,
    D_WRITE            = 2,
    D_TOTAL            = 3,
    D_TARGET_ALIGNMENT = 1,
    RSC_TO_CANNON      = 2,
    MAX_RSC_RPM        = 256,
    CANNON_STALE_S     = 0.3,   -- cannon angles older than this -> aiming inactive
    ROUND_RPM          = true, -- set true if setTargetSpeed rejects fractional RPM
}

-- diagnostics / safety
c.diag = {
    drive_motors     = false, -- false = DRY RUN: angles are computed and shown, RSC speed is forced to 0
    allow_key_toggle = true,  -- key M toggles motors at runtime
    monitor          = nil,   -- e.g. "top" or "monitor_0" to draw the screen on a monitor
    monitor_scale    = 0.5,
    miss_warn        = 5,     -- warn if the predicted miss distance is above this (blocks)
}

return c